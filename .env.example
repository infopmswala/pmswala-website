# Next.js runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/pmswala_next
MONGODB_DB=pmswala_next

# Auth
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_JWT_EXPIRES_IN=2d
ADMIN_BOOTSTRAP_SECRET=replace-with-admin-bootstrap-secret

# Legacy MySQL export source (for migration script)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=pmswala_db
